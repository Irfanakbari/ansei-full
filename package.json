{
  "name": "ansei-inventory-production-system-2026",
  "version": "5.12.4",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev:web": "pnpm --filter @ansei/web dev",
    "dev:api": "pnpm --filter @ansei/api start:dev",
    "dev:printer": "pnpm --filter @ansei/printer start:dev",
    "build": "pnpm -r --if-present run build",
    "build:web": "pnpm --filter @ansei/web build",
    "build:api": "pnpm --filter @ansei/api build",
    "build:printer": "pnpm --filter @ansei/printer build",
    "lint": "pnpm -r --if-present run lint",
    "lint:web": "pnpm --filter @ansei/web lint",
    "lint:api": "pnpm --filter @ansei/api lint",
    "lint:printer": "pnpm --filter @ansei/printer lint",
    "test": "pnpm --filter @ansei/api test",
    "test:api": "pnpm --filter @ansei/api test",
    "test:printer": "pnpm --filter @ansei/printer test",
    "test:e2e:api": "pnpm --filter @ansei/api test:e2e",
    "prisma:validate": "pnpm --filter @ansei/api exec prisma validate",
    "prisma:generate": "pnpm --filter @ansei/api exec prisma generate"
  }
}
