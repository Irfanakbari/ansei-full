# syntax=docker/dockerfile:1

FROM node:22-bookworm AS builder
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@10.0.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY apps/api/package.json apps/api/package.json
COPY vendor vendor
RUN pnpm install --frozen-lockfile
COPY apps/api apps/api
WORKDIR /workspace/apps/api
RUN pnpm exec prisma generate && pnpm run build
WORKDIR /workspace
RUN mkdir -p /runtime/apps/api /runtime/vendor \
    && cp package.json pnpm-lock.yaml pnpm-workspace.yaml /runtime/ \
    && cp apps/api/package.json /runtime/apps/api/package.json \
    && cp vendor/* /runtime/vendor/ \
    && cd /runtime \
    && pnpm install --prod --frozen-lockfile --filter @ansei/api

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV CI=true
ENV LIBREOFFICE_PATH=/usr/bin/soffice
ENV ERROR_LOG_STORAGE_PATH=/app/storage/error-logs
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       dumb-init \
       libreoffice-calc \
       libreoffice-writer \
       fonts-dejavu-core \
       fonts-liberation \
       fontconfig \
       wget \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder --chown=node:node /runtime/node_modules ./node_modules
COPY --from=builder --chown=node:node /runtime/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder --chown=node:node /workspace/apps/api/package.json ./apps/api/package.json
COPY --from=builder --chown=node:node /workspace/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=node:node /workspace/apps/api/prisma ./apps/api/prisma
RUN mkdir -p /app/storage/error-logs \
    && chown -R node:node /app/storage \
    && chmod 700 /app/storage/error-logs
USER node
VOLUME ["/app/storage/error-logs"]
EXPOSE 7500
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 CMD wget --no-verbose --tries=1 --spider http://localhost:7500/health || exit 1
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "apps/api/dist/src/main.js"]
