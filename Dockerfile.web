FROM node:22-alpine AS builder
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@10.0.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY apps/api/package.json apps/api/package.json
RUN pnpm install --frozen-lockfile
COPY apps/web apps/web
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SSO_URL
ARG NEXT_PUBLIC_CALLBACK_AUTH_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_SSO_URL=$NEXT_PUBLIC_SSO_URL
ENV NEXT_PUBLIC_CALLBACK_AUTH_URL=$NEXT_PUBLIC_CALLBACK_AUTH_URL
RUN pnpm --filter @ansei/web build

FROM node:22-alpine AS runner
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@10.0.0 --activate
COPY --from=builder /workspace/package.json /workspace/pnpm-lock.yaml /workspace/pnpm-workspace.yaml ./
COPY --from=builder /workspace/node_modules ./node_modules
COPY --from=builder /workspace/apps/web ./apps/web
ENV NODE_ENV=production
ENV PORT=3005
EXPOSE 3005
WORKDIR /workspace/apps/web
CMD ["pnpm", "start"]
