{"kind":"shape","id":"sh/futkbipc","slide":2,"bbox":[0,0,1280,10]}
{"kind":"textbox","id":"sh/0v214nqx","slide":2,"text":"What we are proposing","textPreview":"What we are proposing","textChars":21,"textLines":1,"bbox":[64,38,1120,54]}
{"kind":"textbox","id":"sh/1wv2d87i","slide":2,"text":"Move ANSEI production transactions into SAP while keeping NOVA focused on shopfloor execution","textPreview":"Move ANSEI production transactions into SAP while keeping NOVA focused on shopfloor execution","textChars":93,"textLines":1,"bbox":[66,96,1080,34]}
{"kind":"textbox","id":"sh/2x4j6do3","slide":2,"text":"Why this matters","textPreview":"Why this matters","textChars":16,"textLines":1,"bbox":[76,166,480,42]}
