{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testMatch": [
    "**/test/**/*.e2e-spec.ts",
    "**/test/master/**/*.spec.ts",
    "**/test/user-management/**/*.spec.ts",
    "**/test/production/**/*.spec.ts",
    "**/test/warehouse/**/*.spec.ts"
  ],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
