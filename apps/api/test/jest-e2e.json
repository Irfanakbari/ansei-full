  "moduleNameMapper": {
    "^src\\/(.*)$": "/Users/vuteqindo/IdeaProjects/api-ansei-revamp/src/$1",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "testTimeout": 60000
}