// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---
// list lokasi barang
enum LocationType {
  WAREHOUSE
  RACK
  FINISH_GOOD_AREA
}

// jenis transaksi buat tracking di ledger
enum TransactionType {
  INCOMING_SUPPLIER
  TRANSFER_TO_RACK
  PRODUCTION_USAGE
  PRODUCTION_RESULT
  DELIVERY_TO_CUSTOMER
  NG_SCRAP
  ADJUSTMENT_MANUAL
  STOCK_OPNAME_DIFF

  MATERIAL_OUT_DELIVERY
}

enum ItemCategory {
  MATERIAL
  FINISH_GOOD
}

enum MaterialSource {
  LOKAL
  OVERSEAS
}

enum OpnameStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// sisa enum bawaan dari db lama
enum TypeShopping {
  REGULER
  ADDITIONAL
}

enum PokayokeCompareStatus {
  SUKSES
  GAGAL
}

enum NotificationType {
  MANAGEMENT
  DEFAULT
}

enum OutboxEventType {
  PRINT_PART_TAG_ANSEI
  DELIVERY_NOTE_EMAIL
  PALLET_CONNECTOR_HISTORY
}

enum OutboxEventStatus {
  PENDING
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum PartType {
  ONE
  TWO
  THREE
  FOUR
}

enum PrintDocumentType {
  PART_TAG_ANSEI
}

enum PrintAgentStatus {
  ACTIVE
  DISABLED
}

enum PrintEnrollmentStatus {
  PENDING
  CONSUMED
  REVOKED
  EXPIRED
}

enum PrintCredentialStatus {
  ACTIVE
  REVOKED
}

enum ProfilePrinterStatus {
  READY
  DISABLED
}

enum PrintJobStatus {
  QUEUED
  LEASED
  DOWNLOADED
  SPOOLING
  SUCCEEDED
  FAILED
  UNCERTAIN
}

enum PrintJobEventType {
  CREATED
  LEASED
  RENEWED
  DOWNLOADED
  SPOOLING
  SUCCEEDED
  FAILED
  LEASE_EXPIRED
}

// --- MASTER DATA ---

model Satuan {
  Id        Int        @id @default(autoincrement())
  Name      String
  CreatedAt DateTime   @default(now())
  CreatedBy String
  UpdatedAt DateTime   @updatedAt
  UpdatedBy String
  Material  Material[]
}

model Supplier {
  Id            Int                    @id @default(autoincrement())
  Name          String
  CreatedAt     DateTime               @default(now())
  CreatedBy     String
  UpdatedAt     DateTime               @updatedAt
  UpdatedBy     String
  Incoming      Incoming[]
  Material      Material[]
  BarcodeFormat SupplierBarcodeFormat?
}

model SupplierBarcodeFormat {
  Id         Int      @id @default(autoincrement())
  SupplierId Int      @unique
  Delimiter  String
  Fields     Json
  CreatedAt  DateTime @default(now())
  CreatedBy  String
  UpdatedAt  DateTime @updatedAt
  UpdatedBy  String
  Supplier   Supplier @relation(fields: [SupplierId], references: [Id], onDelete: Cascade)
}

model Material {
  BomRevisionLines BomRevisionLine[]
  BomSnapshotLines ProductionBomSnapshotLine[]
  Id               Int                         @id @default(autoincrement())
  PartNumber       String                      @unique
  PartName         String
  CreatedAt        DateTime                    @default(now())
  CreatedBy        String
  UpdatedAt        DateTime                    @updatedAt
  UpdatedBy        String
  Supplier         String?
  SupplierId       Int?
  SatuanId         Int?
  RackLocation     String?

  IsActive        Boolean         @default(true)
  DiscontinueDate DateTime?
  MaterialSource  MaterialSource? @default(LOKAL)
  Remark          String?

  // stok cache aja buat nampilin di ui biar cepet
  // realnya (source of truth) tetep hitung dari ledger kalau mau divalidasi
  QtyRack      Int @default(0)
  QtyWarehouse Int @default(0)
  MinimumStock Int @default(0)
  MaximumStock Int @default(0) // 0 means maximum stock is not configured
  QtyPerBox    Int @default(0)

  SatuanData   Satuan?   @relation(fields: [SatuanId], references: [Id])
  SupplierData Supplier? @relation(fields: [SupplierId], references: [Id])

  // relasi ke tabel lain
  BillOfMaterials             BillOfMaterials[]
  IncomingMaterial            IncomingMaterial[]
  MaterialNG                  MaterialNG[]
  Shopping                    Shopping[]
  InventoryLedger             InventoryLedger[]
  StockOpnameDetail           StockOpnameDetail[]
  MaterialDeliveryNoteDetails MaterialDeliveryNoteDetail[]

  @@index([SatuanId], map: "Material_satuanId_fkey")
}

model FinishGood {
  ActiveBomRevisionId String?       @unique
  ActiveBomRevision   BomRevision?  @relation("ActiveBom", fields: [ActiveBomRevisionId], references: [Id], onDelete: Restrict)
  BomRevisions        BomRevision[] @relation("RevisionFinishGood")
  Id                  Int           @id @default(autoincrement())
  PartNumber          String        @unique
  PartName            String
  IsPassthrough       Boolean       @default(false)

  Alias String?

  IsActive        Boolean   @default(true)
  DiscontinueDate DateTime?

  Price     Float?   @default(0)
  CreatedAt DateTime @default(now())
  CreatedBy String
  UpdatedAt DateTime @updatedAt
  UpdatedBy String

  // cache stok fg
  Qty Int @default(0)

  BillOfMaterials   BillOfMaterials[]
  BoxQTY            BoxQTY?
  Forecast          Forecast[]
  LabelData         LabelData[]
  LineStatus        LineStatus[]
  ProductionReport  ProductionReport[]
  InventoryLedger   InventoryLedger[]
  StockOpnameDetail StockOpnameDetail[]
}

model BoxQTY {
  Id         Int        @id @default(autoincrement())
  PartNumber String     @unique
  Qty        Int
  CreatedAt  DateTime   @default(now())
  CreatedBy  String
  UpdatedAt  DateTime   @updatedAt
  UpdatedBy  String
  PartData   FinishGood @relation(fields: [PartNumber], references: [PartNumber])
}

model BillOfMaterials {
  Id           Int @id @default(autoincrement())
  MaterialId   Int
  FinishGoodId Int
  Qty          Int

  FGData       FinishGood @relation(fields: [FinishGoodId], references: [Id], onDelete: Cascade)
  MaterialData Material   @relation(fields: [MaterialId], references: [Id], onDelete: Cascade)

  @@unique([FinishGoodId, MaterialId])
  @@index([MaterialId], map: "BillOfMaterials_materialId_fkey")
}

model ManPower {
  AssemblySessions AssemblySession[]
  Uid              String             @id @default(uuid(4))
  Nik              String             @unique
  PicturePath      String?
  Name             String
  CreatedAt        DateTime           @default(now())
  CreatedBy        String
  UpdatedAt        DateTime           @updatedAt
  UpdatedBy        String
  Status           Boolean            @default(true)
  Line             String?
  ProductionReport ProductionReport[]
  SkillMatrix      SkillMatrix[]
}

model SkillMatrix {
  Id          Int    @id @default(autoincrement())
  ManPowerUid String
  Label       String
  Point       Int // 1-4

  ManPowerData ManPower @relation(fields: [ManPowerUid], references: [Uid], onDelete: Cascade)

  @@index([ManPowerUid])
}

// --- CORE INVENTORY (LEDGER) ---
// ini sumber kebenaran stok (source of truth), gak boleh ada yg kehapus
model InventoryLedger {
  Id              String       @id @default(uuid())
  TransactionDate DateTime     @default(now())
  ItemCategory    ItemCategory

  // isi salah satu aja tergantung barangnya material apa fg
  MaterialId   String?
  FinishGoodId String?

  Location        LocationType
  TransactionType TransactionType

  // no referensi dokumen kayak po, id produksi, id opname dll buat gampang tracking
  ReferenceDoc String

  // mutasi stok (wajib isi urut biar auditnya gampang ditarik)
  BalanceBefore Int
  QtyIn         Int @default(0)
  QtyOut        Int @default(0)
  BalanceAfter  Int

  CreatedBy String
  Notes     String?

  MaterialData Material?   @relation(fields: [MaterialId], references: [PartNumber])
  FGData       FinishGood? @relation(fields: [FinishGoodId], references: [PartNumber])

  @@index([MaterialId, Location])
  @@index([FinishGoodId])
  @@index([TransactionDate])
}

// --- FITUR STOCK OPNAME ---
model StockOpname {
  Id           String       @id @default(uuid())
  OpnameNumber String       @unique
  Category     ItemCategory
  Status       OpnameStatus @default(DRAFT)
  Tolerance    Float?       @default(0)

  CreatedAt   DateTime  @default(now())
  CreatedBy   String
  StartedAt   DateTime? // waktu tombol mulai opname dipencet (snapshot diambil)
  CompletedAt DateTime? // waktu opname di-close/selesai
  CompletedBy String?
  Notes       String?

  Details     StockOpnameDetail[]
  Attachments StockOpnameAttachment[]
}

model StockOpnameDetail {
  Id       Int    @id @default(autoincrement())
  OpnameId String

  MaterialId   String?
  FinishGoodId String?
  Location     LocationType

  SystemQty     Int  @default(0) // qty di sistem saat disnapshoot
  SystemQtyRack Int  @default(0) //qty di sistem bagian qtyrack jika type MATERIAL
  ActualQty     Int? // hasil hitung aktual di lapangan (STO)
  ActualQtyRack Int? // hasil hitung aktual di lapangan (STO) Rack
  DiffQty       Int? // ActualQty - SystemQty (dihitung oleh sistem pas di-submit)
  DiffQtyRack   Int? // ActualQty - SystemQty (dihitung oleh sistem pas di-submit) jika type MATERIAL

  Notes String?

  OpnameData   StockOpname @relation(fields: [OpnameId], references: [Id], onDelete: Cascade)
  MaterialData Material?   @relation(fields: [MaterialId], references: [PartNumber])
  FGData       FinishGood? @relation(fields: [FinishGoodId], references: [PartNumber])

  @@unique([OpnameId, MaterialId, Location])
  @@unique([OpnameId, FinishGoodId, Location])
}

model StockOpnameAttachment {
  Id Int @id @default(autoincrement())

  FileName         String
  FilePath         String
  OriginalFileName String
  FileSize         Int
  MimeType         String

  CreatedAt DateTime @default(now())
  CreatedBy String

  Opname   StockOpname @relation(fields: [OpnameId], references: [Id], onDelete: Cascade)
  OpnameId String

  @@index([OpnameId])
}

// --- TRANSAKSI & OPERASIONAL LAIN-LAIN ---

model Incoming {
  Id               String             @id
  PoId             String             @unique
  Description      String?
  CreatedAt        DateTime           @default(now())
  UpdatedAt        DateTime           @updatedAt
  ReceivedBy       String
  ApprovedAt       DateTime?
  Closed           Boolean            @default(false)
  ApprovedBy       String?
  SupplierId       Int
  SupplierData     Supplier           @relation(fields: [SupplierId], references: [Id])
  IncomingMaterial IncomingMaterial[]

  FileName String?
  FilePath String?

  @@index([SupplierId], map: "Incoming_supplierId_fkey")
}

model IncomingMaterial {
  Id           Int       @id @default(autoincrement())
  IncomingId   String?
  MaterialId   Int?
  Qty          Int       @default(0)
  QtyChecked   Int       @default(0)
  CreatedAt    DateTime  @default(now())
  IncomingData Incoming? @relation(fields: [IncomingId], references: [Id])
  MaterialData Material? @relation(fields: [MaterialId], references: [Id])

  @@index([IncomingId], map: "IncomingMaterial_incomingId_fkey")
  @@index([MaterialId], map: "IncomingMaterial_materialId_fkey")
}

model MaterialNG {
  CaseId                  String?
  SnapshotLineId          String?
  ReplacementRequestedQty Int                        @default(0)
  Case                    MaterialNgCase?            @relation(fields: [CaseId], references: [Id], onDelete: Restrict)
  SnapshotLine            ProductionBomSnapshotLine? @relation(fields: [SnapshotLineId], references: [Id], onDelete: Restrict)
  Replacements            Shopping[]
  Id                      Int                        @id @default(autoincrement())
  MaterialId              String
  Qty                     Int                        @default(0)
  CreatedAt               DateTime                   @default(now())
  CreatedBy               String
  Description             String
  MaterialData            Material                   @relation(fields: [MaterialId], references: [PartNumber])

  @@unique([CaseId, MaterialId])
  @@index([MaterialId], map: "MaterialNG_materialId_fkey")
}

model Forecast {
  BomSnapshots    ProductionBomSnapshot[]
  MaterialNgCases MaterialNgCase[]
  TraceEvents     ProductionTraceEvent[]
  Id              Int                     @id @default(autoincrement())
  PoId            String                  @unique
  Date            DateTime
  VendorCode      String
  VendorName      String
  ReceivingArea   String
  DeliveryDate    DateTime
  DeliveryPeriod  Int
  Classification  String
  PoNumber        String
  Item            Int
  Qty             Int
  FinishGoodId    String

  // Relasi ke jadwal produksi. Jika null, berarti PO ini belum dijadwalkan oleh Leader.
  ProductionReleaseId String?

  DeliveryHistory    DeliveryHistory[]
  PartData           FinishGood          @relation(fields: [FinishGoodId], references: [PartNumber], onDelete: Cascade)
  LabelData          LabelData[]
  Shopping           Shopping[]
  ShoppingCompletion ShoppingCompletion?
  ProductionRelease  ProductionRelease?  @relation(fields: [ProductionReleaseId], references: [Id])
  ProductionReport   ProductionReport[]

  @@index([FinishGoodId], map: "Forecast_finishGoodId_fkey")
  @@index([DeliveryDate])
  @@index([PoId])
  @@index([ProductionReleaseId])
}

enum ProductionStatus {
  DRAFT
  RELEASED
  COMPLETED
  CANCELLED
}

// --- HEADER JADWAL PRODUKSI ---
model ProductionRelease {
  BomSnapshots    ProductionBomSnapshot[]
  MaterialNgCases MaterialNgCase[]
  TraceEvents     ProductionTraceEvent[]
  Id              String                  @id @default(uuid())
  ReleaseNumber   String                  @unique
  PlanDate        DateTime

  Status ProductionStatus @default(DRAFT)
  Notes  String?

  // Rekap total agar UI dashboard lebih ringan (tidak perlu sum dari child)
  TotalTargetQty         Int  @default(0)
  TotalGoodQty           Int  @default(0)
  TotalNgQty             Int  @default(0)
  // Actual production duration entered at closure; null for historical releases.
  TotalProductionMinutes Int?

  CreatedAt DateTime @default(now())
  CreatedBy String
  UpdatedAt DateTime @updatedAt

  IsNoAttachment Boolean @default(false)

  // 1 Jadwal rilis BANYAK PO (Forecast)
  Forecasts   Forecast[]
  LabelDatas  LabelData[]
  Attachments ProductionReleaseAttachment[]

  @@index([PlanDate])
  @@index([Status])
}

model ProductionReleaseAttachment {
  id Int @id @default(autoincrement())

  FileName         String?
  FilePath         String?
  OriginalFileName String?
  FileSize         Int?
  MimeType         String?

  CreatedAt DateTime @default(now())
  CreatedBy String?
  UpdatedAt DateTime @updatedAt
  UpdatedBy String?

  ProductionRelease   ProductionRelease? @relation(fields: [ProductionReleaseId], references: [Id])
  ProductionReleaseId String?

  @@index([ProductionReleaseId])
  @@map("DeliveryAttachment")
}

model Shopping {
  Purpose        ShoppingPurpose            @default(LEGACY_UNCLASSIFIED)
  Destination    String?
  SnapshotLineId String?
  MaterialNgId   Int?
  CommandId      String?
  SnapshotLine   ProductionBomSnapshotLine? @relation(fields: [SnapshotLineId], references: [Id], onDelete: Restrict)
  MaterialNg     MaterialNG?                @relation(fields: [MaterialNgId], references: [Id], onDelete: Restrict)
  Command        BusinessCommand?           @relation(fields: [CommandId], references: [Id], onDelete: Restrict)
  Id             String                     @id
  Description    String?
  Type           TypeShopping
  CreatedAt      DateTime                   @default(now())
  UpdatedAt      DateTime                   @updatedAt
  ForecastId     String?
  CreatedBy      String
  QtyPick        Int
  MaterialId     String

  ForecastData Forecast? @relation(fields: [ForecastId], references: [PoId], onDelete: Restrict)
  MaterialData Material  @relation(fields: [MaterialId], references: [PartNumber])

  @@index([ForecastId], map: "Shopping_forecastId_fkey")
  @@index([MaterialId], map: "Shopping_materialId_fkey")
}

model ShoppingCompletion {
  ForecastId String   @id
  ShoppingId String   @unique
  CreatedAt  DateTime @default(now())
  CreatedBy  String

  Forecast Forecast @relation(fields: [ForecastId], references: [PoId], onDelete: Cascade)

  @@index([CreatedAt])
}

model OutboxEvent {
  PrintJob       PrintJob?
  Id             String            @id @default(uuid())
  IdempotencyKey String            @unique @db.VarChar(255)
  Type           OutboxEventType
  Payload        Json
  Status         OutboxEventStatus @default(PENDING)
  Attempts       Int               @default(0)
  MaxAttempts    Int               @default(5)
  NextAttemptAt  DateTime          @default(now())
  LastErrorCode  String?           @db.VarChar(64)
  LastError      String?           @db.VarChar(500)
  CreatedAt      DateTime          @default(now())
  UpdatedAt      DateTime          @updatedAt
  QueuedAt       DateTime?
  ProcessingAt   DateTime?
  SucceededAt    DateTime?
  FailedAt       DateTime?
  Actor          String?           @db.VarChar(255)
  ReferenceType  String?           @db.VarChar(64)
  ReferenceId    String?           @db.VarChar(255)

  @@index([Status, NextAttemptAt])
  @@index([ReferenceType, ReferenceId, CreatedAt])
}

model ProductionReport {
  MaterialNgCases MaterialNgCase[]
  Id              Int              @id @default(autoincrement())
  Date            String?
  Time            String?
  ProductionStamp DateTime
  NgQty           Int              @default(0)
  StartTime       String?
  StartStamp      DateTime?
  EndTime         String?
  EndStamp        DateTime?
  StopMinute      Int?             @default(0)
  LatchDate       String?
  CableHDate      String?
  CableLDate      String?
  CoverDate       String?
  RodDate         String?
  SponsDate       String?
  SponsRearDate   String?
  ClipDate        String?
  LeverDate       String?
  SmallPadDate    String?
  ActuatorDate    String?
  BackPlateDate   String?
  StampDate       String?
  PoNumber        String?
  CreatedAt       DateTime         @default(now())
  UpdatedAt       DateTime         @updatedAt
  ValidatedAt     DateTime?
  ValidatedBy     String?
  RecordType      PartType?
  Qty             Int              @default(0)
  ManPowerUid     String
  FinishGoodId    String
  ForecastId      String?

  ManPowerData ManPower   @relation(fields: [ManPowerUid], references: [Uid])
  FGData       FinishGood @relation(fields: [FinishGoodId], references: [PartNumber])
  ForecastData Forecast?  @relation(fields: [ForecastId], references: [PoId])

  @@unique([Date, ManPowerUid, FinishGoodId, CreatedAt])
  @@index([ForecastId])
}

model LabelData {
  MaterialNgCases  MaterialNgCase[]
  RequiresAssembly Boolean?
  AssemblySessions AssemblySession[]
  Id               Int               @id @default(autoincrement())
  LabelNumber      String            @unique
  FinishGoodId     String
  ForecastId       String //Ambil dari POID
  Scanned          Boolean           @default(false)
  QtyThisBox       Int               @default(0)

  DeliveryHistory       DeliveryHistory?
  PokayokeHistory       PokayokeScanHistory[]
  PartData              FinishGood            @relation(fields: [FinishGoodId], references: [PartNumber])
  POData                Forecast              @relation(fields: [ForecastId], references: [PoId], onDelete: Cascade)
  ProductionRelease     ProductionRelease?    @relation(fields: [ProductionReleaseId], references: [Id])
  ProductionReleaseId   String?
  PokayokeScanHistoryId String?

  @@index([FinishGoodId], map: "LabelData_finishGoodId_fkey")
  @@index([ForecastId], map: "LabelData_forecastId_fkey")
  @@index([ProductionReleaseId])
}

enum AssemblyStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model AssemblySession {
  MaterialNgCases   MaterialNgCase[]
  Id                String           @id @default(uuid())
  LabelDataId       Int
  ManPowerUid       String
  ManPowerName      String
  Status            AssemblyStatus   @default(IN_PROGRESS)
  StartedAt         DateTime         @default(now())
  EndedAt           DateTime?
  CancelledAt       DateTime?
  CancelledBy       String?
  CancelReason      String?
  StartRequestId    String           @unique
  CompleteRequestId String?          @unique
  CreatedBy         String
  CompletedBy       String?
  Channel           String
  LabelData         LabelData        @relation(fields: [LabelDataId], references: [Id], onDelete: Restrict)
  ManPower          ManPower         @relation(fields: [ManPowerUid], references: [Uid], onDelete: Restrict)

  @@index([LabelDataId, Status])
  @@index([ManPowerUid, Status])
  @@index([StartedAt])
}

model PokayokeScanHistory {
  Id          Int                   @id @default(autoincrement())
  LabelNumber String
  PoId        String //Forecast.PoId
  PartNumber  String
  PartName    String
  CreatedAt   DateTime              @default(now())
  CreatedBy   String
  Status      PokayokeCompareStatus

  LabelData   LabelData? @relation(fields: [LabelDataId], references: [Id])
  LabelDataId Int?
}

model DeliveryHistory {
  Id           Int      @id @default(autoincrement())
  ForecastId   String //ambil dari PoID
  Qty          Int
  PalletNumber String?
  CreatedAt    DateTime @default(now())
  CreatedBy    String
  LabelDataId  String   @unique(map: "DeliveryHistory_pk")

  PoData    Forecast  @relation(fields: [ForecastId], references: [PoId])
  LabelData LabelData @relation(fields: [LabelDataId], references: [LabelNumber])

  @@index([ForecastId], map: "DeliveryHistory_forecastId_fkey")
  @@index([CreatedAt])
}

// --- SYSTEM SETTINGS ---

model LineStatus {
  Id           Int    @id @default(autoincrement())
  LineName     String
  FinishGoodId String

  CurrentProduction FinishGood @relation(fields: [FinishGoodId], references: [PartNumber])

  @@index([FinishGoodId], map: "LineStatus_finishGoodId_fkey")
}

model EmailNotification {
  Id        Int              @id @default(autoincrement())
  Name      String
  Email     String
  Type      NotificationType @default(DEFAULT)
  CreatedAt DateTime         @default(now())
  CreatedBy String
  UpdatedAt DateTime         @updatedAt
  UpdatedBy String
}

model DashboardSetting {
  Id        Int      @id @default(autoincrement())
  StartDate DateTime
  EndDate   DateTime
  UpdatedAt DateTime
}

// --- AUDIT LOG ---

model LogProcess {
  AuditEvents       ActionAuditEvent[]
  TraceEvents       ProductionTraceEvent[]
  ProcessId         String                 @id @db.VarChar(50)
  FunctionId        String                 @db.VarChar(50)
  FunctionName      String                 @db.VarChar(255)
  ProcessStatus     String                 @db.VarChar(20)
  ProcessStart      DateTime
  ProcessEnd        DateTime?
  ProcessDate       DateTime
  CreatedAt         DateTime
  CreatedBy         String?
  LogProcessDetails LogProcessDetail[]

  @@index([ProcessId])
  @@index([FunctionId])
  @@index([ProcessDate])
  @@index([ProcessStatus])
}

// Operational evidence only; before/after values are selected by database triggers.
model ActionAuditEvent {
  Id          String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  SourceType  String
  SourceId    String
  Action      String
  Actor       String?
  ActorSource String
  RequestId   String?
  ProcessId   String?
  Before      Json?
  After       Json?
  CreatedAt   DateTime    @default(now())
  Process     LogProcess? @relation(fields: [ProcessId], references: [ProcessId], onDelete: Restrict)

  @@index([CreatedAt, Id])
  @@index([ProcessId, CreatedAt])
  @@index([RequestId, CreatedAt])
  @@index([SourceType, SourceId, CreatedAt])
}

model LogProcessDetail {
  ProcessDetailId BigInt      @id @default(autoincrement())
  ProcessId       String      @db.VarChar(50)
  MessageId       String      @db.VarChar(50)
  Message         String      @db.Text
  Type            String      @db.VarChar(20)
  Location        String      @db.VarChar(255)
  ProcessDate     DateTime
  CreatedAt       DateTime
  LogProcess      LogProcess? @relation(fields: [ProcessId], references: [ProcessId], onDelete: Cascade, onUpdate: Cascade)

  @@index([ProcessId])
  @@index([MessageId])
  @@index([Type])
  @@index([ProcessDate])
}

model MTCUserSession {
  SessionId String   @id @default(uuid())
  UserId    String
  UserAgent String
  IpAddress String
  IsActive  Boolean  @default(true)
  CreatedAt DateTime @default(now())
  ExpiresAt DateTime
}

model MTCUserManagement {
  Id          String    @id @default(uuid())
  UserId      String    @unique
  PhoneNumber String?   @db.VarChar(32)
  IsActive    Boolean   @default(true)
  Name        String
  LastLogin   DateTime?
  Email       String    @unique
  CreatedAt   DateTime  @default(now())
  CreatedBy   String
  UpdatedAt   DateTime  @updatedAt
  UpdatedBy   String

  SsoObjectId String @unique

  RoleId      Int?
  Role        MTCRole?     @relation(fields: [RoleId], references: [Id], onUpdate: Cascade)
  mtcauthLogs MTCAuthLog[]
  ApiKeys     ApiKey[]

  @@index([Email])
  @@index([SsoObjectId])
}

enum MTCAuthAction {
  LOGIN
  LOGOUT
  SSO_CALLBACK
}

enum MTCAuthStatus {
  SUCCESS
  FAILED
}

model MTCAuthLog {
  Id            String        @id @default(uuid())
  UserId        String?
  EmailAttempt  String?       @db.VarChar(255)
  Action        MTCAuthAction
  Status        MTCAuthStatus
  FailureReason String?       @db.VarChar(255)
  IpAddress     String?       @db.VarChar(45)
  UserAgent     String?
  CreatedAt     DateTime      @default(now())

  User MTCUserManagement? @relation(fields: [UserId], references: [UserId], onDelete: Cascade)

  @@index([UserId])
  @@index([CreatedAt])
  @@index([EmailAttempt])
}

model MTCRole {
  Id          Int                 @id @default(autoincrement())
  RoleName    String              @unique
  Description String?
  CreatedAt   DateTime            @default(now()) @map("CreateDate")
  CreatedBy   String              @map("CreateBy")
  UpdatedAt   DateTime            @updatedAt @map("UpdateDate")
  UpdatedBy   String              @map("UpdateBy")
  Permission  MTCPermission[]
  Users       MTCUserManagement[]
}

model MTCPermission {
  Id          Int       @id @default(autoincrement())
  Action      String    @unique
  Description String?
  CreatedAt   DateTime  @default(now()) @map("CreateDate")
  CreatedBy   String    @map("CreateBy")
  UpdatedAt   DateTime  @updatedAt @map("UpdateDate")
  UpdatedBy   String    @map("UpdateBy")
  Roles       MTCRole[]

  @@index([Action])
}

enum DeliveryNoteStatus {
  DRAFT
  SHIPPED
  RECEIVED // Barang sudah sampai dan diterima di tujuan
  CANCELLED
}

// --- HEADER SURAT JALAN MATERIAL ---
model MaterialDeliveryNote {
  Id              String             @id @default(uuid())
  DeliveryNoteNum String             @unique // Contoh: SJ-MAT/2026/06/0001
  Destination     String // Lokasi tujuan pengiriman
  Status          DeliveryNoteStatus @default(DRAFT)
  Notes           String? // Alasan pengeluaran (misal: Retur, Transfer Subcont, dll)
  DNPath          String? //URL Surat Jalan
  // Timestamps & Aktor
  CreatedAt       DateTime           @default(now())
  CreatedBy       String
  ShippedAt       DateTime? // Kapan barang mulai dikirim keluar
  ShippedBy       String?
  ReceivedAt      DateTime? // Kapan barang dikonfirmasi sampai di tujuan
  ReceivedBy      String? // Siapa yang menerima di tujuan

  Details MaterialDeliveryNoteDetail[]

  @@index([Status])
  @@index([DeliveryNoteNum])
}

// --- DETAIL BARANG DI SURAT JALAN ---
model MaterialDeliveryNoteDetail {
  Id             Int    @id @default(autoincrement())
  DeliveryNoteId String
  MaterialId     String

  FinishGoodPartTemp String?

  QtyRequested Int // Jumlah yang direncanakan/diminta dikeluarkan
  QtyPicking   Int //jumlah yg sudah di prepare siap kirim, harus = qtyRequested
  QtyReceived  Int? // Jumlah aktual yang diterima di tujuan (bisa jadi ada selisih dijalan)

  // Relasi
  DeliveryNoteData MaterialDeliveryNote @relation(fields: [DeliveryNoteId], references: [Id], onDelete: Cascade)
  MaterialData     Material             @relation(fields: [MaterialId], references: [PartNumber])

  @@unique([DeliveryNoteId, MaterialId])
}

model PrintAgent {
  Id              String                 @id @default(uuid())
  Name            String
  Status          PrintAgentStatus       @default(ACTIVE)
  LastHeartbeatAt DateTime?
  Version         String?
  Metadata        Json?
  CreatedAt       DateTime               @default(now())
  CreatedBy       String
  UpdatedAt       DateTime               @updatedAt
  UpdatedBy       String
  Enrollments     PrintAgentEnrollment[]
  Credentials     PrintAgentCredential[]
  Profiles        ProfilePrinter[]
  Jobs            PrintJob[]
  JobEvents       PrintJobEvent[]

  @@index([Status, LastHeartbeatAt])
}

model PrintAgentEnrollment {
  Id          String                @id @default(uuid())
  AgentId     String
  TokenHash   String                @unique @db.VarChar(64)
  TokenPrefix String                @db.VarChar(16)
  Status      PrintEnrollmentStatus @default(PENDING)
  ExpiresAt   DateTime?
  ConsumedAt  DateTime?
  CreatedAt   DateTime              @default(now())
  CreatedBy   String
  Agent       PrintAgent            @relation(fields: [AgentId], references: [Id], onDelete: Cascade)

  @@index([AgentId, Status])
  @@index([ExpiresAt])
}

model PrintAgentCredential {
  Id           String                @id @default(uuid())
  AgentId      String
  SecretHash   String                @unique @db.VarChar(64)
  SecretPrefix String                @db.VarChar(16)
  Status       PrintCredentialStatus @default(ACTIVE)
  LastUsedAt   DateTime?
  ExpiresAt    DateTime?
  RevokedAt    DateTime?
  CreatedAt    DateTime              @default(now())
  CreatedBy    String
  Agent        PrintAgent            @relation(fields: [AgentId], references: [Id], onDelete: Cascade)

  @@index([AgentId, Status])
}

model ProfilePrinter {
  Id              String               @id @default(uuid())
  AgentId         String
  ExternalId      String
  Name            String
  DocumentType    PrintDocumentType
  Status          ProfilePrinterStatus @default(READY)
  IsDefault       Boolean              @default(false)
  Revision        Int
  ProfileSnapshot Json
  SyncedAt        DateTime
  CreatedAt       DateTime             @default(now())
  UpdatedAt       DateTime             @updatedAt
  Agent           PrintAgent           @relation(fields: [AgentId], references: [Id], onDelete: Cascade)
  Jobs            PrintJob[]

  @@unique([AgentId, ExternalId])
  @@index([DocumentType, Status, IsDefault])
}

model PrintJob {
  Id              String            @id @default(uuid())
  OutboxEventId   String            @unique
  ProfileId       String
  AgentId         String
  DocumentType    PrintDocumentType
  Status          PrintJobStatus    @default(QUEUED)
  PayloadSnapshot Json
  ProfileSnapshot Json
  Attempt         Int               @default(0)
  LeaseTokenHash  String?           @db.VarChar(64)
  LeaseExpiresAt  DateTime?
  DownloadedAt    DateTime?
  SpoolingAt      DateTime?
  SucceededAt     DateTime?
  FailedAt        DateTime?
  ErrorCode       String?           @db.VarChar(64)
  ErrorMessage    String?           @db.VarChar(500)
  CreatedAt       DateTime          @default(now())
  UpdatedAt       DateTime          @updatedAt
  OutboxEvent     OutboxEvent       @relation(fields: [OutboxEventId], references: [Id], onDelete: Restrict)
  Profile         ProfilePrinter    @relation(fields: [ProfileId], references: [Id], onDelete: Restrict)
  Agent           PrintAgent        @relation(fields: [AgentId], references: [Id], onDelete: Restrict)
  Events          PrintJobEvent[]

  @@index([AgentId, Status, CreatedAt])
  @@index([LeaseExpiresAt])
}

model PrintJobEvent {
  Id         String            @id @default(uuid())
  JobId      String
  AgentId    String?
  Type       PrintJobEventType
  FromStatus PrintJobStatus?
  ToStatus   PrintJobStatus
  Attempt    Int
  Detail     Json?
  CreatedAt  DateTime          @default(now())
  Job        PrintJob          @relation(fields: [JobId], references: [Id], onDelete: Cascade)
  Agent      PrintAgent?       @relation(fields: [AgentId], references: [Id], onDelete: Restrict)

  @@index([JobId, CreatedAt])
}

model ApiKey {
  Id          String    @id @default(uuid())
  KeyHash     String    @unique // SHA-256 hash of the API key
  KeyPrefix   String
  Name        String
  Description String?
  UserId      String
  IsActive    Boolean   @default(true)
  LastUsedAt  DateTime?
  CreatedAt   DateTime  @default(now())
  CreatedBy   String
  UpdatedAt   DateTime  @updatedAt
  UpdatedBy   String

  User MTCUserManagement @relation(fields: [UserId], references: [UserId])
}

model DisplayConfig {
  Id          Int      @id @default(autoincrement())
  Description String
  CreatedAt   DateTime @default(now())
  CreatedBy   String
  UpdatedAt   DateTime @updatedAt
  UpdatedBy   String
  IsOpen      Boolean  @default(false)
  Url         String?
  Loop        Boolean  @default(true)
  FilePath    String?
  Line        String?
}

enum BomRevisionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  CANCELLED
}

enum ShoppingPurpose {
  STANDARD
  NG_REPLACEMENT
  NON_PRODUCTION
  LEGACY_UNCLASSIFIED
}

enum MaterialNgCaseStatus {
  OPEN
  FULFILLED
  CLOSED
  CANCELLED
}

model BomRevision {
  Id               String                  @id @default(uuid())
  FinishGoodId     Int
  Revision         Int
  Status           BomRevisionStatus       @default(DRAFT)
  BaseRevisionId   String?
  Reason           String
  Version          Int                     @default(1)
  CreatedBy        String
  LastEditedBy     String
  CreatedAt        DateTime                @default(now())
  UpdatedAt        DateTime                @updatedAt
  SubmittedBy      String?
  SubmittedAt      DateTime?
  ApprovedBy       String?
  ApprovedAt       DateTime?
  FinishGood       FinishGood              @relation("RevisionFinishGood", fields: [FinishGoodId], references: [Id], onDelete: Restrict)
  ActiveFor        FinishGood?             @relation("ActiveBom")
  BaseRevision     BomRevision?            @relation("RevisionBase", fields: [BaseRevisionId], references: [Id], onDelete: Restrict)
  DerivedRevisions BomRevision[]           @relation("RevisionBase")
  Lines            BomRevisionLine[]
  Snapshots        ProductionBomSnapshot[]
  Events           BomRevisionEvent[]

  @@unique([FinishGoodId, Revision])
  @@index([Status, CreatedAt])
}

model BomRevisionLine {
  Id         String      @id @default(uuid())
  RevisionId String
  MaterialId Int
  Qty        Int
  PartNumber String
  PartName   String
  UnitName   String?
  Revision   BomRevision @relation(fields: [RevisionId], references: [Id], onDelete: Restrict)
  Material   Material    @relation(fields: [MaterialId], references: [Id], onDelete: Restrict)

  @@unique([RevisionId, MaterialId])
}

model BomRevisionEvent {
  Id         String      @id @default(uuid())
  RevisionId String
  Action     String
  Actor      String
  Reason     String
  Version    Int
  CreatedAt  DateTime    @default(now())
  Revision   BomRevision @relation(fields: [RevisionId], references: [Id], onDelete: Restrict)

  @@index([RevisionId, CreatedAt])
}

model ProductionBomSnapshot {
  Id                   String                      @id @default(uuid())
  ForecastId           String
  ReleaseId            String
  RevisionId           String
  Version              Int
  PreviousId           String?                     @unique
  TargetQty            Int
  FinishGoodPartNumber String
  FinishGoodPartName   String
  CreatedBy            String
  CreatedAt            DateTime                    @default(now())
  Forecast             Forecast                    @relation(fields: [ForecastId], references: [PoId], onDelete: Restrict)
  Release              ProductionRelease           @relation(fields: [ReleaseId], references: [Id], onDelete: Restrict)
  Revision             BomRevision                 @relation(fields: [RevisionId], references: [Id], onDelete: Restrict)
  Previous             ProductionBomSnapshot?      @relation("PreviousSnapshot", fields: [PreviousId], references: [Id], onDelete: Restrict)
  Next                 ProductionBomSnapshot?      @relation("PreviousSnapshot")
  Lines                ProductionBomSnapshotLine[]
  MaterialNgCases      MaterialNgCase[]

  @@unique([ForecastId, ReleaseId, Version])
  @@index([ReleaseId])
}

model ProductionBomSnapshotLine {
  Id          String                @id @default(uuid())
  SnapshotId  String
  MaterialId  Int
  QtyPerUnit  Int
  RequiredQty Int
  PartNumber  String
  PartName    String
  UnitName    String?
  Snapshot    ProductionBomSnapshot @relation(fields: [SnapshotId], references: [Id], onDelete: Restrict)
  Material    Material              @relation(fields: [MaterialId], references: [Id], onDelete: Restrict)
  Shopping    Shopping[]
  MaterialNG  MaterialNG[]

  @@unique([SnapshotId, MaterialId])
}

model MaterialNgCase {
  Id                 String                @id @default(uuid())
  CaseNumber         String                @unique
  ForecastId         String
  ReleaseId          String
  SnapshotId         String
  Stage              String
  Reason             String
  Status             MaterialNgCaseStatus  @default(OPEN)
  CreatedBy          String
  CreatedAt          DateTime              @default(now())
  ClosedBy           String?
  ClosedAt           DateTime?
  CloseReason        String?
  LabelId            Int?
  AssemblySessionId  String?
  ProductionReportId Int?
  Forecast           Forecast              @relation(fields: [ForecastId], references: [PoId], onDelete: Restrict)
  Release            ProductionRelease     @relation(fields: [ReleaseId], references: [Id], onDelete: Restrict)
  Snapshot           ProductionBomSnapshot @relation(fields: [SnapshotId], references: [Id], onDelete: Restrict)
  Label              LabelData?            @relation(fields: [LabelId], references: [Id], onDelete: Restrict)
  AssemblySession    AssemblySession?      @relation(fields: [AssemblySessionId], references: [Id], onDelete: Restrict)
  ProductionReport   ProductionReport?     @relation(fields: [ProductionReportId], references: [Id], onDelete: Restrict)
  Details            MaterialNG[]

  @@index([ForecastId, CreatedAt])
  @@index([ReleaseId, Status])
}

model BusinessCommand {
  Id          String     @id @default(uuid())
  Scope       String
  RequestId   String
  Fingerprint String
  Actor       String
  Result      Json?
  CreatedAt   DateTime   @default(now())
  Shopping    Shopping[]

  @@unique([Scope, RequestId])
}

model ProductionTraceEvent {
  Id            String             @id @default(uuid())
  ForecastId    String
  ReleaseId     String?
  Type          String
  SourceType    String
  SourceId      String
  Actor         String
  CorrelationId String
  ProcessId     String?
  Metadata      Json?
  CreatedAt     DateTime           @default(now())
  Forecast      Forecast           @relation(fields: [ForecastId], references: [PoId], onDelete: Restrict)
  Release       ProductionRelease? @relation(fields: [ReleaseId], references: [Id], onDelete: Restrict)
  Process       LogProcess?        @relation(fields: [ProcessId], references: [ProcessId], onDelete: Restrict)

  @@index([ForecastId, CreatedAt, Id])
  @@index([CorrelationId])
}
