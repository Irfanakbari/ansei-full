# ============================================
# Production Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# Database Configuration
DATABASE_URL=postgresql://app_user:replace-at-deploy-time@postgres:5432/ansei

# Application Configuration
PORT=7500
NODE_ENV=production
ERROR_LOG_STORAGE_PATH=/app/storage/error-logs
ERROR_LOG_RETENTION=14d
ERROR_LOG_MAX_SIZE=20m

# Vuteq SSO Configuration
VUTEQ_SSO_ENABLED=true
VUTEQ_SSO_BASE_URL=https://sso.vuteq.co.id
VUTEQ_SSO_SECRET=load-from-secret-manager
VUTEQ_SSO_ALLOWED_CLIENT_IDS=replace-at-deploy-time

# Redis Configuration (for BullMQ queues and distributed coordination)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_REQUIRED=true

# Optional integrations
NAS_ENABLED=false
NAS_HOST=nas.example.internal
NAS_PORT=5001
NAS_PROTOCOL=https
NAS_ALLOW_HTTP_PRIVATE_NETWORK=false
NAS_USER=load-from-secret-manager
NAS_PASSWORD=load-from-secret-manager
NAS_SMB_SHARE=AssetStorage
NAS_SMB_SUBFOLDER=Ansei_Asset
NAS_BASE_URL=https://files.example.com/Ansei_Asset/

SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=load-from-secret-manager
SMTP_PASS=load-from-secret-manager
SMTP_FROM=ansei@example.com
SMTP_FROM_NAME=ANSEI System

DOCUMENT_CONVERTER_ENABLED=true
LIBREOFFICE_PATH=/usr/bin/libreoffice
WASM_PATH=/app/wasm

# Operations endpoints and API documentation
HEALTH_READINESS_PROTECTED=false
HEALTH_READINESS_TOKEN=load-from-secret-manager
SWAGGER_ENABLED=false
SWAGGER_API_KEY=load-from-secret-manager

# PostgreSQL Configuration (for docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=load-from-secret-manager
POSTGRES_DB=ansei

# SAP B1 material existence check (server only; no stock or master writes).
SAP_SYNC_ENABLED=false
SAP_SERVICE_LAYER_URL=https://sap.example.com:50000/b1s/v2/
SAP_COMPANY_DB=
SAP_USERNAME=
SAP_PASSWORD=
SAP_MATERIAL_ITEM_GROUP=128
# Prefer a trusted CA via NODE_EXTRA_CA_CERTS at process startup.
# Set false only for an explicitly trusted SAP self-signed endpoint (SAP connections only).
SAP_TLS_REJECT_UNAUTHORIZED=true

# FG - Sales 2 (verified in SAP)
SAP_FINISH_GOOD_ITEM_GROUP=120

# Enable only after applying SAP_MATERIAL_UPDATE enum migration.
SAP_MATERIAL_WRITE_ENABLED=false

# Optional: 32 random bytes encoded as 64 hex characters, identical on API/worker replicas.
# Encrypts shared SAP sessions in Redis; blank keeps sessions process-local.
SAP_SESSION_CACHE_KEY=

# Operational SAP integration. Enable only after a reviewed cutover baseline.
SAP_TRANSACTION_CAPTURE_ENABLED=false
SAP_TRANSACTION_WRITE_ENABLED=false
SAP_TRANSACTION_WAREHOUSE=DMY-ANS
SAP_TRANSACTION_PROJECT_CODE=2010
SAP_TRANSACTION_COST_CENTER=2000
SAP_TRANSACTION_ITEM_ALLOWLIST=5715B132-KD
SAP_TRANSACTION_MATERIAL_ALLOWLIST=

# Create one SAP SO per demand at release; customer mapping is mandatory.
SAP_AUTO_SALES_ORDER_ENABLED=false
