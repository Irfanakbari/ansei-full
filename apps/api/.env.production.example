# ============================================
# Production Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# Database Configuration
DATABASE_URL=postgresql://postgres:your_secure_password@postgres:5432/ansei

# Application Configuration
PORT=7500
NODE_ENV=production

# JWT Configuration - CHANGE THIS IN PRODUCTION!
SECRET_KEY=generate-a-secure-random-string-here
JWT_EXPIRES_IN=24h

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ Configuration (for Printer Service)
PRINTER_RMQ_URL=amqp://rabbitmq:5672
PRINTER_RMQ_QUEUE=printer_queue

# PostgreSQL Configuration (for docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=ansei

# Azure AD Configuration (optional - for SSO authentication)
# AZURE_AD_CLIENT_ID=
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_SECRET=


